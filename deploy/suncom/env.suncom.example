# /srv/nudgelabapi/.env on suncom-nudgelab-web (100.59.145.97). Copy to .env, fill every FILL, then chmod 600 .env.
# Never commit the filled-in file, never paste its values into chat or email. Passwords in the URLs below are
# URL-encoded (a password with @ : / ? # % or & needs it: python3 -c "import urllib.parse,getpass;
# print(urllib.parse.quote(getpass.getpass(), safe=''))").

APP_ENV=prod
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=America/Chicago

CORS_ORIGINS=https://nudgelab.mysuncomportal.com
DASHBOARD_BASE_URL=https://nudgelab.mysuncomportal.com

# database-1 (Suncom's RDS, us-east-2): the logins from 01-logins.sql. Every login requires TLS, which the
# driver uses on its own (the preflight's "database" line shows it connecting).
DATABASE_URL=mysql+pymysql://nudgelab_api:FILL@database-1.clxw6d5bqw8i.us-east-2.rds.amazonaws.com:3306/nudgeai?charset=utf8mb4
DATABASE_MIGRATION_URL=mysql+pymysql://nudgelab_api_migrate:FILL@database-1.clxw6d5bqw8i.us-east-2.rds.amazonaws.com:3306/nudgeai?charset=utf8mb4

# Sign-in tokens:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=FILL

# The first Admin (venv/bin/python -m scripts.bootstrap_admin), then DELETE the password line.
BOOTSTRAP_ADMIN_EMAIL=bgupta@primecomms.com
BOOTSTRAP_ADMIN_FULL_NAME=Binay Gupta
BOOTSTRAP_ADMIN_PASSWORD=FILL

# Email (invitations, password resets, Portal sync codes, the daily summary): later, with Suncom's mailbox.
# Until then emails wait in the outbox; Admins set people's temporary passwords themselves.
EMAIL_ENABLED=false
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_MAILBOX=

# Claude: Anthropic's API (AWS gave this account no Bedrock quota). The key from console.anthropic.com.
ANTHROPIC_API_KEY=FILL

# S3 and AWS services through this server's role (suncom-nudgelab-api). No AWS keys here, ever.
RECORDINGS_BUCKET=suncom-nudgelab-data
RECORDINGS_REGION=us-east-1
CONTENT_BUCKET=suncom-nudgelab-data
CONTENT_REGION=us-east-1

EXPORT_DIR=/var/lib/nudgelabapi/exports
EXPORT_MAX_ROWS=100000
EXPORT_KEEP_HOURS=24

# Suncom's LiveKit project (the same three values as the agent servers' .env.local).
LIVEKIT_URL=wss://nudgelab-suncom-e4wqe7sq.livekit.cloud
LIVEKIT_API_KEY=FILL
LIVEKIT_API_SECRET=FILL
# Preview calls: the same value as PREVIEW_SECRET on the agent servers.  openssl rand -hex 32
PREVIEW_SECRET=FILL

# The Suncom app / portal training page: not used yet.
APP_PASS_PUBLIC_KEYS=

# The reference sync: copies v_users_all, v_users, v_stores, v_stores_all from suncomportal into nudgeai.
PORTALLIVE_DATABASE_URL=mysql+pymysql://nudgelab_portal_ro:FILL@database-1.clxw6d5bqw8i.us-east-2.rds.amazonaws.com:3306/suncomportal?charset=utf8mb4
REFERENCE_SYNC_DATABASE_URL=mysql+pymysql://nudgelab_sync:FILL@database-1.clxw6d5bqw8i.us-east-2.rds.amazonaws.com:3306/nudgeai?charset=utf8mb4
REFERENCE_SYNC_ALERT_EMAIL=bgupta@primecomms.com
