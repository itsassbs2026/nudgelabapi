# /srv/nudgelabapi/.env on the pingitapi server (SPEC §14.3). Copy this file to .env, fill it in, then:
#   chmod 600 .env
# Never commit the filled-in file, never paste its values into chat or email.
# Values marked FILL come from you; nothing here is a real secret.

APP_ENV=prod
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=America/Chicago

# The dashboard's address: browsers may only call the API from here, and emails link to it.
CORS_ORIGINS=https://nudgelab.myprimeportal.com
DASHBOARD_BASE_URL=https://nudgelab.myprimeportal.com

# The running API: the read-mostly login from deploy/db-logins.sql part 1 (FILL the password you set there).
# Host: the RDS endpoint pingit's .env uses (same server, same database host).
DATABASE_URL=mysql+pymysql://nudgelab_api:FILL@FILL-rds-endpoint:3306/nudgeai?charset=utf8mb4
# Migrations only (deploy/db-logins.sql part 2): used by `alembic` during a deploy, never by the app.
DATABASE_MIGRATION_URL=mysql+pymysql://nudgelab_api_migrate:FILL@FILL-rds-endpoint:3306/nudgeai?charset=utf8mb4

# Sign-in tokens. Generate once with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=FILL

# The first Admin: created once with `venv/bin/python -m scripts.bootstrap_admin`. Use a temporary password
# (12+ characters; it must be changed at first sign-in), then DELETE the password line from this file.
BOOTSTRAP_ADMIN_EMAIL=bgupta@primecomms.com
BOOTSTRAP_ADMIN_FULL_NAME=Binay Gupta
BOOTSTRAP_ADMIN_PASSWORD=FILL

# Email (invitations, password resets) through Microsoft Graph: copy the four GRAPH_* values from pingit's
# .env on this server, then set EMAIL_ENABLED=true. Until then emails wait in the outbox.
EMAIL_ENABLED=false
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_MAILBOX=

# Recordings: read through this server's instance role (Prime-nudgeapi-ec2-role + deploy/iam-policy-stage1.json).
# No AWS keys here, ever.
RECORDINGS_BUCKET=nudgeailab
RECORDINGS_REGION=us-west-1

# XLSX exports, built by the worker and served by the API (both run as ubuntu).
EXPORT_DIR=/var/lib/nudgelabapi/exports
EXPORT_MAX_ROWS=100000
EXPORT_KEEP_HOURS=24

# "Live now" on the Overview: the same LiveKit project as the voice agent (copy the three values from the agent
# server's .env.local). Leave blank to keep the card off.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Preview calls (Phase 15): the same value as PREVIEW_SECRET in the agent server's .env.local.
# Generate with `openssl rand -hex 32`; never commit it.
PREVIEW_SECRET=

# The Flutter app (/app/v1, docs/APP_HANDOFF.md). Wanaka's public key for NudgeLab passes, as kid=path (the kid
# Wanaka puts in NUDGE_PASS_KID). Not a secret, but keep the file outside the repo, e.g. /srv/nudgelabapi/keys/.
# During a key rotation list both: kid1=/path/one.pem,kid2=/path/two.pem. Blank: the app endpoints answer 503.
# Session starts also need the three LIVEKIT_* values above.
APP_PASS_PUBLIC_KEYS=

# The PortalLive reference-table sync (scripts/sync_reference_tables.py, deploy/README.md). Its own logins, never
# the API's (deploy/db-grants-0012-reference-sync.sql). Passwords URL-encoded. Blank: the sync fails and says so.
PORTALLIVE_DATABASE_URL=mysql+pymysql://nudgelab_portal_ro:<password>@<PortalLive host>:3306/primetwok?charset=utf8mb4
REFERENCE_SYNC_DATABASE_URL=mysql+pymysql://nudgelab_sync:<password>@<nudgeai host>:3306/nudgeai?charset=utf8mb4
# Who hears about a failed sync (sent through Graph, like password resets).
REFERENCE_SYNC_ALERT_EMAIL=nudgeai@primecomms.com
