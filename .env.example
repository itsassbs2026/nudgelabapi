APP_ENV=alpha
CORS_ORIGINS=http://localhost:5173
DEFAULT_TIMEZONE=America/Chicago
LOG_LEVEL=INFO

# Local development database (never the production nudgeai database).
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/nudgeai_dev?charset=utf8mb4
# DDL login, used only by `alembic upgrade` (SPEC §6.1). Falls back to DATABASE_URL when blank.
DATABASE_MIGRATION_URL=

# Tests: a disposable local database. Its name must end in "_test" (tests/conftest.py refuses anything else).
TEST_DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/nudgeai_test?charset=utf8mb4

# Auth (SPEC §9). Generate the secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-secret
DASHBOARD_BASE_URL=http://localhost:5173

# First Admin (python -m scripts.bootstrap_admin), then remove the password from this file.
BOOTSTRAP_ADMIN_EMAIL=bgupta@primecomms.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=Binay Gupta

# Password-reset email via Microsoft Graph (reuse pingit's values). Off until all are set.
EMAIL_ENABLED=false
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_MAILBOX=

# Session recordings (Phase 4). Credentials come from the EC2 instance role, never from here.
RECORDINGS_BUCKET=nudgeailab
RECORDINGS_REGION=us-west-1

# Exports (Phase 5). XLSX files are built by the worker here and deleted after EXPORT_KEEP_HOURS. On the server,
# use a directory both the API and the worker can write, e.g. /var/lib/nudgelabapi/exports.
EXPORT_DIR=var/exports
EXPORT_MAX_ROWS=100000
EXPORT_KEEP_HOURS=24
